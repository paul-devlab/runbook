      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(runbook_ask_questions_total{outcome=~\"answered|cut_short\"}[24h]))",
          "legendFormat": "answered"
        }
