# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit it, and never put real secrets in this file.

# --- PostgreSQL (used by the db service in compose.yaml) ---
POSTGRES_USER=runbook
POSTGRES_DB=runbook
# Pick your own local password. Only reachable from inside the Compose network.
POSTGRES_PASSWORD=change-me
