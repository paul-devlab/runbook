# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit it, and never put real secrets in this file.

# --- PostgreSQL (used by the db service in compose.yaml) ---
POSTGRES_USER=runbook
POSTGRES_DB=runbook
# Pick your own local password. Only reachable from inside the Compose network.
POSTGRES_PASSWORD=change-me

# --- Login sessions (app/config.py) ---
# Both have safe defaults; compose.yaml already sets SESSION_COOKIE_SECURE=false
# because local dev is plain http://. Never set it to false where HTTPS is used.
# SESSION_COOKIE_SECURE=true
# SESSION_TTL_HOURS=12

# --- Ask, using Claude (app/ask.py) ---
# Create a key in the Claude Console (platform.claude.com), in a workspace with a
# monthly spend limit. Without one, the Ask page just says it isn't set up.
ANTHROPIC_API_KEY=
# Optional: which Claude model answers (default claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5
